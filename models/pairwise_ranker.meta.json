{
  "model_type": "xgboost",
  "feature_names": [
    "name_exact_punct",
    "name_exact_compressed",
    "name_exact_stripped",
    "legal_suffix_match",
    "name_fuzz_ratio",
    "name_fuzz_partial",
    "name_token_sort",
    "name_token_set",
    "name_stripped_ratio",
    "name_ngram_jaccard",
    "name_shared_token_count",
    "name_token_jaccard",
    "name_len_diff",
    "name_len_ratio",
    "s1_addr_missing",
    "cand_addr_missing",
    "both_addr_present",
    "hn_exact_match",
    "hn_contradiction",
    "postal_exact_match",
    "postal_prefix_match",
    "postal_contradiction",
    "addr_fuzz_ratio",
    "addr_token_sort",
    "addr_token_set",
    "is_source2",
    "is_source3",
    "country_match",
    "retrieval_score",
    "retrieved_by_exact",
    "retrieved_by_comp",
    "retrieved_by_token",
    "retrieved_by_addr"
  ],
  "config": {
    "device": "cuda",
    "n_jobs": 32,
    "seed": 42,
    "chunk_size": 250000,
    "max_candidates_per_entity": 50,
    "min_name_token_length": 3,
    "max_token_df_filter": 500,
    "tfidf_char_ngram_range": [
      3,
      5
    ],
    "top_k_tfidf": 30,
    "model_type": "xgboost",
    "n_estimators": 600,
    "learning_rate": 0.05,
    "max_depth": 7,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "neg_to_pos_ratio": 7,
    "match_threshold": 0.5,
    "empty_threshold": 0.35,
    "max_matches_per_entity": 10,
    "relative_score_gap": 0.2
  }
}